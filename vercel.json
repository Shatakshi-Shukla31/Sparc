{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.iitrpr.ac.in/sparc2026/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://www.iitrpr.ac.in/sparc2026/:path*",
      "permanent": false
    }
  ]
}
